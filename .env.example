# ==============================================================================
# SALMAN V5 — VARIABLES DE ENTORNO PARA PRODUCCIÓN Y DESPLIEGUE EN VERCEL
# ==============================================================================
# Registra estas variables en el panel de Vercel:
# Project Settings > Environment Variables (https://salaman-web-v5.vercel.app/)
# O copia este archivo como .env.local para tus pruebas locales:
#   cp .env.example .env.local
# ==============================================================================

# 1. Google Gemini Flash API (Google AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# 2. Meta WhatsApp Cloud API (Meta Developers > WhatsApp > API Setup: https://developers.facebook.com/)
# Token de acceso permanente (System User) o temporal de Meta Graph API
META_ACCESS_TOKEN=your_meta_system_user_or_temporary_token_here

# Identificador del número de teléfono (Phone Number ID) asignado por Meta en el Dashboard
META_PHONE_NUMBER_ID=your_meta_phone_number_id_here

# Token secreto definido para la verificación del webhook de Meta (Webhooks > Verify Token)
META_VERIFY_TOKEN=salman_meta_verify_token_2026

# 3. Flujo de Demostración y Validación Directiva / Diseñadora (Opcional):
# Si se especifica, todos los resúmenes y citas capturados por Salma se enviarán a este número
# para validar la recepción inmediata en vivo durante la presentación con el equipo:
# Ejemplo: 573244286166 (formato internacional sin signos ni espacios)
META_NOTIFICATION_RECIPIENT=
